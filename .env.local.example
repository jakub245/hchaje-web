# Web3Forms - formulář pro nábor
# Registrace: https://web3forms.com
# 1. Vytvoř si účet na web3forms.com
# 2. Vytvoř nový formulář
# 3. V Settings nastav: Recipient Email, Email Subject, Sender Name
# 4. Zkopíruj si access key (UUID) a vlož ho sem:
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Notion API - integrációnské API
NOTION_TOKEN=your_notion_token_here
NOTION_NEWS_DATABASE_ID=your_news_database_id_here
NOTION_COACHES_DATABASE_ID=your_coaches_database_id_here
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here
